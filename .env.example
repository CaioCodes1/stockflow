# ---------------------------------------------------------------------------
# Copie este arquivo para `.env` e ajuste os valores.
#
# Por que variaveis de ambiente, e nao valores no codigo?
#  1. Segredo nao entra no Git. O .env esta no .gitignore; o .env.example, nao.
#  2. O mesmo codigo roda em maquinas diferentes (sua, do colega, do servidor)
#     apenas trocando o arquivo de configuracao.
#  3. Trocar uma senha vazada nao exige alterar e reimplantar o codigo.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Conexao com o PostgreSQL usado pelo Prisma.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
# Os valores abaixo batem com o docker-compose.yml deste repositorio.
DATABASE_URL="postgresql://stockflow:stockflow@localhost:5432/stockflow?schema=public"

# Banco separado, usado apenas por `npm test`.
# Os testes APAGAM todas as tabelas antes de rodar - nunca aponte para o banco
# de desenvolvimento.
TEST_DATABASE_URL="postgresql://stockflow:stockflow@localhost:5432/stockflow_test?schema=public"

# Segredo usado para ASSINAR os tokens JWT.
# Em producao: string longa e aleatoria. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-valor-por-uma-string-longa-e-aleatoria"
JWT_EXPIRES_IN=8h

# Custo do bcrypt. Cada +1 DOBRA o tempo de hash (e o do atacante).
# 10-12 e a faixa recomendada hoje.
BCRYPT_SALT_ROUNDS=10

# Origens autorizadas a chamar a API pelo navegador. Separadas por virgula.
# Use `*` apenas em desenvolvimento.
CORS_ORIGIN=*

# error | warn | info | debug
LOG_LEVEL=info

# Usuario ADMIN criado pelo `npm run db:seed`.
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@stockflow.com"
SEED_ADMIN_PASSWORD="Admin@123"
